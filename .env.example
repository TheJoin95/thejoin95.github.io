# Set the public origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave disabled until the custom-domain release. Enabled requires HTTPS and
# a custom canonical host. Netlify previews/branches always remain noindex.
SITE_INDEXING=disabled

# Optional: GA4 web stream measurement ID (G-XXXXXXXXXX).
# Tracking stays disabled when empty and in development. Netlify preview/branch
# contexts explicitly clear this value; Vercel previews are also excluded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only Brevo configuration. Never use NEXT_PUBLIC_ for these.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=

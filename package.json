{
  "name": "miki-lombardi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "bun run build:tools && bun --bun next build --turbopack",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test:ci",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage --bail",
    "build:tools": "bun build ./scripts/verify-env.ts --target=bun --env=disable --outdir=dist/tools --minify",
    "verify:env": "bun ./scripts/verify-env.ts",
    "verify:services": "bun ./scripts/verify-env.ts --remote",
    "test:e2e": "bun --bun playwright test"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.22.0",
    "@next/third-parties": "16.4.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.9.0"
  }
}

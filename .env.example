# Set the public origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: GA4 web stream measurement ID (G-XXXXXXXXXX).
# Tracking stays disabled when empty, in development, and on Vercel previews.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only Brevo configuration. Never use NEXT_PUBLIC_ for these.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=

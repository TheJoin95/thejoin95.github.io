{
  "name": "miki-lombardi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run verify:seo && bun run build:journal && bun run build:fox && bun --bun next dev --turbopack",
    "build": "bun run verify:seo && bun run build:journal && bun run build:fox && bun run build:tools && bun --bun next build --turbopack",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test:ci",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage --bail",
    "build:tools": "bun build ./scripts/verify-env.ts --target=bun --env=disable --outdir=dist/tools --minify",
    "verify:env": "bun ./scripts/verify-env.ts",
    "verify:services": "bun ./scripts/verify-env.ts --remote",
    "test:e2e": "bun run build:test-fixtures && bun --bun playwright test",
    "build:test-fixtures": "bun build e2e/fixtures/gallery.tsx e2e/fixtures/fox.tsx e2e/fixtures/accessibility.tsx --target=browser --env=disable --define 'process.env={\"NODE_ENV\":\"production\"}' --outdir=.test-fixtures && bun scripts/build-reader-fixture.tsx",
    "build:journal": "bun scripts/build-journal.ts",
    "build:fox": "bun scripts/build-fox.ts",
    "migrate:legacy": "bun scripts/migrate-legacy.ts",
    "verify:seo": "bun scripts/verify-seo.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.22.0",
    "@next/third-parties": "16.4.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "feed": "6.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lottiefiles/dotlottie-web": "0.83.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fflate": "0.8.3",
    "svg-pathdata": "9.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.9.0"
  }
}
